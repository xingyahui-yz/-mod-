    },
    {
      "participant": "repository",
      "from": 798,
      "to": 858,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "失败语义",
      "items": [
        "取消通过 AbortSignal 中止，迟到响应丢弃",
        "最终保存失败时回复不可见，也不延迟补写"
      ]
    },
    {
      "dot": "emerald",
      "title": "审计语义",
      "items": [
        "失败、超时、取消、中断均保留 attempt",
        "重试读取最新项目基线；成功轮次可刷新 rolling summary"
      ]
    },
    {
      "dot": "cyan",
      "title": "上下文边界",
      "items": [
        "模型最多请求一次 Card 上下文补取",
        "补取快照先持久化，再进行第二次模型调用"
      ]
    }
  ]
