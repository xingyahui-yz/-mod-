{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "项目级 AI 对话单轮时序",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1320,
      980
    ]
  },
  "participants": [
    {
      "id": "author",
      "type": "external",
      "label": "用户"
    },
    {
      "id": "drawer",
      "type": "frontend",
      "label": "对话抽屉"
    },
    {
      "id": "controller",
      "type": "backend",
      "label": "ProjectConversation"
    },
    {
      "id": "catalog",
      "type": "backend",
      "label": "CardCatalog"
    },
    {
      "id": "validator",
      "type": "security",
      "label": "响应校验器"
    },
    {
      "id": "repository",
      "type": "database",
      "label": "ConversationRepository"
    },
    {
      "id": "provider",
      "type": "cloud",
      "label": "LLM Provider"
    }
  ],
  "segments": [
    {
      "label": "准备与持久化",
      "from": 150,
      "to": 365
    },
    {
      "label": "模型执行与可选补取",
      "from": 366,
      "to": 715
    },
    {
      "label": "最终校验与展示",
      "from": 716,
      "to": 920
    }
  ],
  "messages": [
    {
      "id": "s1",
      "from": "author",
      "to": "drawer",
      "y": 180,
      "label": "输入消息并显式附加 Card"
    },
    {
      "id": "s2",
      "from": "drawer",
      "to": "controller",
      "y": 228,
      "label": "send(text, attachments)"
    },
    {
      "id": "s3",
      "from": "controller",
      "to": "catalog",
      "y": 276,
      "label": "读取目录摘要与附件 revision"
    },
    {
      "id": "s4",
      "from": "controller",
      "to": "repository",
      "y": 324,
      "label": "原子保存用户消息 + running attempt"
    },
    {
      "id": "s5",
      "from": "repository",
      "to": "controller",
      "y": 372,
      "label": "保存成功后才允许调用模型"
    },
    {
      "id": "s6",
      "from": "controller",
      "to": "provider",
      "y": 420,
      "label": "发送 token 预算内结构化请求"
    },
    {
      "id": "s7",
      "from": "provider",
      "to": "controller",
      "y": 468,
      "label": "返回 final 或 expand-context",
      "variant": "return"
    },
    {
      "id": "s8",
      "from": "controller",
      "to": "validator",
      "y": 516,
      "label": "校验响应与补取 Card ID"
    },
    {
      "id": "s9",
      "from": "controller",
      "to": "repository",
      "y": 564,
      "label": "仅补取时：保存扩展上下文快照",
      "variant": "security"
    },
    {
      "id": "s10",
      "from": "repository",
      "to": "controller",
      "y": 612,
      "label": "快照保存成功",
      "variant": "return"
    },
    {
      "id": "s11",
      "from": "controller",
      "to": "provider",
      "y": 660,
      "label": "仅补取时：再次调用模型"
    },
    {
      "id": "s12",
      "from": "provider",
      "to": "controller",
      "y": 708,
      "label": "返回 final 响应",
      "variant": "return"
    },
    {
      "id": "s13",
      "from": "controller",
      "to": "validator",
      "y": 756,
      "label": "严格校验 text / quickReplies / proposals"
    },
    {
      "id": "s14",
      "from": "validator",
      "to": "repository",
      "y": 804,
      "label": "原子保存完整助手响应",
      "variant": "security"
    },
    {
      "id": "s15",
      "from": "repository",
      "to": "controller",
      "y": 852,
      "label": "提交成功",
      "variant": "return"
    },
    {
      "id": "s16",
      "from": "controller",
      "to": "drawer",
      "y": 890,
      "label": "此时才展示正文、快捷回复与提案",
      "variant": "emphasis"
    }
  ],
  "activations": [
