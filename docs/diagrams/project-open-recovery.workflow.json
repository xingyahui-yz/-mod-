{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "项目打开与 Card 恢复流程",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [
      900,
      760
    ]
  },
  "lanes": [
    {
      "id": "userLane",
      "label": "用户"
    },
    {
      "id": "projectLane",
      "label": "项目生命周期"
    },
    {
      "id": "repoLane",
      "label": "CardRepository"
    },
    {
      "id": "recoveryLane",
      "label": "迁移与隔离",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "open",
    "flush",
    "scan",
    "classify",
    "loadEditable",
    "catalogReady"
  ],
  "nodes": [
    {
      "id": "open",
      "lane": "userLane",
      "col": 0,
      "type": "external",
      "label": "打开或切换项目"
    },
    {
      "id": "flush",
      "lane": "projectLane",
      "col": 1,
      "type": "backend",
      "label": "切换守卫：flush 草稿",
      "sublabel": "等待事务；运行 AI 时确认取消",
      "width": 155
    },
    {
      "id": "scan",
      "lane": "repoLane",
      "col": 2,
      "type": "database",
      "label": "扫描 Card 文档",
      "width": 105,
      "sublabel": "项目源文件"
    },
    {
      "id": "classify",
      "lane": "repoLane",
      "col": 3,
      "type": "security",
      "label": "逐 Card 分类"
    },
    {
      "id": "loadEditable",
      "lane": "projectLane",
      "col": 4,
      "type": "backend",
      "label": "装载可编辑 Card",
      "width": 100
    },
    {
      "id": "catalogReady",
      "lane": "projectLane",
      "col": 5,
      "type": "frontend",
      "label": "目录就绪",
      "width": 88
    },
    {
      "id": "migrate",
      "lane": "recoveryLane",
      "col": 3,
      "type": "backend",
      "label": "已知版本迁移",
      "sublabel": "先备份，再逐版本升级",
      "width": 125
    },
    {
      "id": "readonly",
      "lane": "recoveryLane",
      "col": 5,
      "type": "security",
      "label": "只读隔离保留",
      "sublabel": "未知 schema / kind",
      "width": 110
    }
  ],
  "edges": [
    {
      "id": "p1",
      "from": "open",
      "to": "flush",
      "role": "main"
    },
    {
      "id": "p2",
      "from": "flush",
      "to": "scan",
      "role": "main"
    },
    {
      "id": "p3",
      "from": "scan",
      "to": "classify",
      "role": "main"
    },
    {
      "id": "p4",
      "from": "classify",
      "to": "loadEditable",
      "role": "main"
    },
    {
      "id": "p5",
      "from": "loadEditable",
      "to": "catalogReady",
      "role": "main"
    },
    {
      "id": "p6",
      "from": "classify",
      "to": "migrate",
      "role": "branch",
      "route": "drop"
    },
    {
      "id": "p8",
      "from": "classify",
      "to": "readonly",
      "role": "error",
      "route": "drop"
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "迁移与隔离",
      "items": [
        "迁移成功后进入可编辑装载；失败数据保留原文",
        "单张 Card 故障不阻止其余 Card",
        "未知数据保留原文而非丢弃"
      ]
    },
    {
      "dot": "cyan",
      "title": "正常路径",
      "items": [
        "CardDocument 是编辑状态的权威来源",
        "旧 C# 导入是独立的用户显式流程"
      ]
    }
  ]
}
